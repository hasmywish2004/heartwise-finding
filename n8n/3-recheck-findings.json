      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const orig = $(\"Build Term\").item.json;\nconst resp = $json;\nconst res = resp.result || null;\nlet newClassification = null;\nif (res && !resp.error) {\n  const uids = res.uids || [];\n  const rsNum = orig.rsid ? String(orig.rsid).replace(/^rs/i, \"\") : null;\n  const hg = (!orig.rsid && orig.variant_key) ? String(orig.variant_key).split(\":\").slice(1).join(\":\").replace(/\\s+/g, \"\") : null;\n  const gene = String(orig.gene || \"\").toUpperCase();\n  let best = null; let bestSubs = -1;\n  for (const u of uids) {\n    const r = res[u];\n    if (!r) continue;\n    const vs = r.variation_set || [];\n    if (vs.length !== 1) continue;\n    const v = vs[0];\n    const desc = String((r.germline_classification || {}).description || \"\").toLowerCase();\n    if (desc.indexOf(\"no classification\") !== -1) continue;\n    let ok = false;\n    if (rsNum) {\n      ok = (v.variation_xrefs || []).some(function (x) { return x.db_source === \"dbSNP\" && String(x.db_id) === rsNum; });\n    } else if (hg) {\n      const name = (String(v.cdna_change || \"\") + \" \" + String(v.variation_name || \"\")).replace(/\\s+/g, \"\");\n      ok = name.indexOf(hg) !== -1;\n      if (ok && gene) { ok = (r.genes || []).some(function (g) { return String(g.symbol).toUpperCase() === gene; }) || name.toUpperCase().indexOf(\"(\" + gene + \")\") !== -1; }\n    }\n    if (ok) {\n      const subs = ((r.supporting_submissions || {}).scv || []).length;\n      if (subs > bestSubs) { best = r; bestSubs = subs; }\n    }\n  }\n  if (best) { newClassification = (best.germline_classification || {}).description || null; }\n}\nconst oldClassification = orig.classification;\nconst changed = !!(newClassification && oldClassification && newClassification.toLowerCase() !== oldClassification.toLowerCase());\nreturn [{ json: {\n  id: orig.id,\n  is_stale: changed,\n  previous_classification: changed ? oldClassification : null,\n  classification: newClassification || oldClassification,\n  checked_at: new Date().toISOString()\n} }];"
      },
      "id": "db8ef485-3b1e-43de-b00e-dbcdfaebbb59",
