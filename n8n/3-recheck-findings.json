        "jsCode": "const o = $json;\nconst hg = (!o.rsid && o.variant_key) ? String(o.variant_key).split(\":\").slice(1).join(\":\") : null;\nconst term = o.rsid ? o.rsid : ((o.gene || \"\") + \"[gene] AND \" + (hg || \"\"));\nreturn [{ json: Object.assign({}, o, { clinvar_term: term }) }];"
      },
