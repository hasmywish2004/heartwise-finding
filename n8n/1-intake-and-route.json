        "jsCode": "const meta = $(\"Sniff The File\").first().json;\nconst raw = ($input.first().json.text || \"\").trim();\nif (!raw || raw.indexOf(\"NO_VARIANTS_FOUND\") !== -1) {\n  return [{ json: { upload_id: meta.upload_id, nothing_found: true } }];\n}\nconst lines = raw.split(/\\r?\\n/);\nconst out = [];\nfor (const line of lines) {\n  if (line.indexOf(\"|\") === -1) { continue; }\n  const c = line.split(\"|\").map(function (x) { return x.trim(); });\n  const clean = function (v) { return (!v || v === \"NONE\") ? null : v; };\n  if (!clean(c[0])) { continue; }\n  out.push({ json: {\n    upload_id: meta.upload_id,\n    source: \"lab_report\",\n    gene: clean(c[0]),\n    hgvs_c: clean(c[1]),\n    hgvs_p: clean(c[2]),\n    zygosity: clean(c[3]),\n    lab_classification: clean(c[4]),\n    genome_build: clean(c[5]),\n    user_confirmed: false\n  } });\n}\nif (out.length === 0) { return [{ json: { upload_id: meta.upload_id, nothing_found: true } }]; }\nreturn out;"
