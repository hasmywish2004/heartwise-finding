    {
      "parameters": {
        "jsCode": "const uploadId = $(\"Read Upload Id\").first().json.upload_id;\nconst filename = $(\"Get Upload Row\").first().json.filename || \"\";\nlet buf = null;\ntry { buf = await this.helpers.getBinaryDataBuffer(0, \"data\"); } catch (e) { buf = null; }\nif (!buf || buf.length === 0) {\n  return [{ json: { upload_id: uploadId, filename: filename, detected_type: \"unknown\", path: \"R\", reason: \"No file content was received from storage.\", bytes: 0 } }];\n}\nconst head = buf.subarray(0, 8192);\nconst isPdf = head[0] === 0x25 && head[1] === 0x50 && head[2] === 0x44 && head[3] === 0x46;\nconst isJpg = head[0] === 0xFF && head[1] === 0xD8 && head[2] === 0xFF;\nconst isPng = head[0] === 0x89 && head[1] === 0x50 && head[2] === 0x4E && head[3] === 0x47;\nconst isZip = head[0] === 0x50 && head[1] === 0x4B && head[2] === 0x03 && head[3] === 0x04;\nconst isGzip = head[0] === 0x1F && head[1] === 0x8B;\nlet detected = \"unknown\";\nlet path = \"R\";\nlet reason = null;\nif (isPdf) {\n  detected = \"pdf\"; path = \"B\";\n} else if (isJpg || isPng) {\n  detected = \"image\"; path = \"B\";\n} else if (isZip) {\n  detected = \"zip\";\n  reason = \"This is a zip file. 23andMe and AncestryDNA downloads arrive zipped - please unzip it and upload the .txt file inside.\";\n} else if (isGzip) {\n  detected = \"gzip\";\n  reason = \"This is a compressed .gz file. Please decompress it and upload the plain text or .vcf file.\";\n} else {\n  const text = head.toString(\"utf8\");\n  const looksVcf = /^##fileformat=VCF/im.test(text) || /^#CHROM\\s+POS/im.test(text);\n  const looksGenotype = /rsid[\\s\",]*[,\\t][\\s\",]*chromosome/i.test(text) || /^\"?(rs|i)\\d+\"?[\\t,]\\s*\"?\\w+\"?[\\t,]\\s*\"?\\d+/im.test(text);\n  if (looksVcf) { detected = \"vcf\"; path = \"A\"; }\n  else if (looksGenotype) { detected = \"genotype_text\"; path = \"A\"; }\n  else { reason = \"This file is not a raw genotype file and is not a PDF or photo of a lab report. We only read consumer DNA data files, PDF lab reports, and photos of lab reports.\"; }\n}\nreturn [{ json: { upload_id: uploadId, filename: filename, detected_type: detected, path: path, reason: reason, bytes: buf.length } }];"
      },
