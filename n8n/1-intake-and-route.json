    {
      "parameters": {
        "jsCode": "const panel = $(\"Load Frozen Panel\").all().map(function (r) { return r.json; });\nconst meta = $(\"Sniff The File\").first().json;\nconst buf = await this.helpers.getBinaryDataBuffer(0, \"data\");\nconst text = buf.toString(\"utf8\");\nconst lines = text.split(/\\r?\\n/);\nconst byPos = {};\nfor (const p of panel) { byPos[String(p.chrom) + \":\" + String(p.pos)] = p; }\nconst found = {};\nconst noCall = {};\nlet dataRows = 0;\nfor (const line of lines) {\n  if (!line || line.charAt(0) === \"#\") { continue; }\n  const cols = line.indexOf(\"\\t\") !== -1 ? line.split(\"\\t\") : line.split(\",\");\n  if (cols.length < 4) { continue; }\n  const clean = cols.map(function (c) { return String(c).replace(/^\\\"|\\\"$/g, \"\").trim(); });\n  if (/^rsid$/i.test(clean[0]) || /^#?CHROM$/i.test(clean[0])) { continue; }\n  dataRows++;\n  let chrom; let pos; let geno;\n  if (meta.detected_type === \"vcf\") {\n    chrom = clean[0].replace(/^chr/i, \"\"); pos = clean[1];\n    const ref = clean[3]; const alt = clean[4];\n    const gtField = clean[9] ? clean[9].split(\":\")[0] : \"\";\n    const alleles = gtField.split(/[\\/|]/);\n    geno = alleles.map(function (a) { return a === \"0\" ? ref : (a === \"1\" ? alt : \"?\"); }).join(\"\");\n  } else {\n    chrom = clean[1].replace(/^chr/i, \"\"); pos = clean[2];\n    geno = clean.length >= 5 ? (clean[3] + clean[4]) : clean[3];\n  }\n  geno = String(geno || \"\").toUpperCase();\n  const key = chrom + \":\" + pos;\n  if (byPos[key] && !found[key]) {\n    // A no-call (--, 00, ??, or anything that is not two letters A/C/G/T) is treated as missing, never as zero copies.\n    if (!/^[ACGT]{1,2}$/.test(geno)) { noCall[key] = geno; continue; }\n    const p = byPos[key];\n    found[key] = { upload_id: meta.upload_id, source: \"dna_file\", gene: p.gene, rsid: p.rsid, genome_build: p.genome_build, chrom: p.chrom, pos: p.pos, ref: p.ref, alt: p.alt, genotype: geno, panel_variant_id: p.id, user_confirmed: true, not_covered: false };\n  }\n}\nconst out = [];\nfor (const p of panel) {\n  const key = String(p.chrom) + \":\" + String(p.pos);\n  if (found[key]) { out.push({ json: found[key] }); }\n  else { out.push({ json: { upload_id: meta.upload_id, source: \"dna_file\", gene: p.gene, rsid: p.rsid, genome_build: p.genome_build, chrom: p.chrom, pos: p.pos, ref: p.ref, alt: p.alt, genotype: null, panel_variant_id: p.id, user_confirmed: true, not_covered: true, no_call: noCall[key] !== undefined } }); }\n}\nif (out.length > 0) {\n  out[0].json.rows_read = dataRows;\n  out[0].json.rows_kept = Object.keys(found).length;\n  out[0].json.rows_discarded = dataRows - Object.keys(found).length;\n}\nreturn out;"
      },
